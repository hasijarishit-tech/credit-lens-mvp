# Copy this file to .env and fill in real values. Never commit the real .env file.

# Random long string used to sign login tokens. Any long random text works.
SECRET_KEY=change-this-to-a-long-random-string

# Used later (Stage 2) for Claude-powered extraction and narrative generation.
ANTHROPIC_API_KEY=

# SQLite database file (default is fine for the hackathon MVP)
DATABASE_URL=sqlite:///./creditlens.db
